DATABASE_URL=postgresql://user:password@host:5432/postgres
FLASK_SECRET_KEY=change-me
WHATSAPP_NUMBER=5577900000000
ADMIN_PASSWORD=troque-por-uma-senha-forte

# Armazenamento das fotos enviadas pelo admin (imóvel, hero, equipe,
# notícias, "quem somos") — necessário em produção (Vercel), onde o
# filesystem é somente leitura. Sem essas duas variáveis, o app volta a
# salvar em disco (bom para rodar local, ruim em produção).
# SUPABASE_URL: Project Settings → API → Project URL.
# SUPABASE_SERVICE_ROLE_KEY: Project Settings → API → service_role secret
# (NUNCA exponha essa chave no frontend — só como variável de servidor).
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Geocodificação gratuita (Nominatim/OpenStreetMap). A política de uso deles
# pede um User-Agent com identificação da aplicação e uma forma de contato.
# Troque o e-mail abaixo por um contato real antes de publicar o site.
NOMINATIM_USER_AGENT="VDC-Imoveis/1.0 (https://seu-dominio.com.br; contato@seu-dominio.com.br)"
